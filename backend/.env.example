# Production example. Copy to backend/.env and replace every placeholder.
NODE_ENV=production
PORT=5000

# Admin login. Use a long unique username and a password of 14+ characters.
ADMIN_USER=choose-a-unique-admin-username
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-64-random-characters

# Comma-separated browser origins allowed to call the API.
# Example when the site is served by this same Node server:
ALLOWED_ORIGINS=https://your-domain.in

# Optional email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=brightkolors0218@gmail.com
